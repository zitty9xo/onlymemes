# Firebase Configuration (Create a project at https://console.firebase.google.com)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# GIPHY API (Create a free app at https://developers.giphy.com)
VITE_GIPHY_API_KEY=your_giphy_api_key_here

# Google Gemini API for Multimodal AI Moderation (https://aistudio.google.com)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Cloud Media Storage Configuration ('azure' or 'firebase')
VITE_STORAGE_PROVIDER=azure
VITE_AZURE_STORAGE_ACCOUNT=your_storage_account_name
VITE_AZURE_STORAGE_CONTAINER=your_container_name
VITE_AZURE_STORAGE_SAS_TOKEN=your_azure_sas_token_here
