{
  "name": "onlymeme-workspace",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "deploy:rules": "npx firebase-tools deploy --config backend/firebase.json --only firestore:rules,storage:rules",
    "deploy:hosting": "npx firebase-tools deploy --config backend/firebase.json --only hosting",
    "deploy": "npm run build && npx firebase-tools deploy --config backend/firebase.json"
  }
}
